# Copy to .env for local dev. In Render, set these as Environment Variables
# on the backend Web Service instead of committing a .env file.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-KEEP-SECRET
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# The payer-simulator service's own URL (its Render URL once deployed).
PAYER_SIMULATOR_URL=http://localhost:8081

# Shared secret the payer-simulator must send back on its callback so the
# backend knows the decision genuinely came from it. Make up any long
# random string and use the SAME value in the payer-simulator's env too.
PAYER_CALLBACK_SECRET=change-this-to-a-random-string

PORT=8080
